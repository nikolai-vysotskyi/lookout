{
    "name": "nikolai-vysotskyi/lookout",
    "description": "Open-source, self-hosted alternative to Laravel Nightwatch for Laravel apps: requests, jobs, queries, exceptions, issues and an MCP server, on top of the NightOwl agent.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "nightwatch",
        "nightwatch-alternative",
        "laravel-nightwatch",
        "monitoring",
        "apm",
        "observability",
        "self-hosted",
        "open-source",
        "nightowl",
        "mcp",
        "performance",
        "error-tracking"
    ],
    "homepage": "https://github.com/nikolai-vysotskyi/lookout",
    "support": {
        "issues": "https://github.com/nikolai-vysotskyi/lookout/issues",
        "source": "https://github.com/nikolai-vysotskyi/lookout",
        "security": "https://github.com/nikolai-vysotskyi/lookout/security/policy"
    },
    "authors": [
        {
            "name": "Nikolai Vysotskyi"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nightowl/agent": "^2.4",
        "open-telemetry/gen-otlp-protobuf": "^1.8"
    },
    "require-dev": {
        "laravel/mcp": "^0.5|^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "laravel/mcp": "Serves the Lookout MCP server for coding agents.",
        "laravel/nova": "lookout.auth = nova reuses Nova's login and gate; Lookout\\Nova\\LookoutMenu adds a sidebar link.",
        "inertiajs/inertia-laravel": "Answers Inertia visits (e.g. from the Nova sidebar) with a full-page load."
    },
    "autoload": {
        "psr-4": {
            "Lookout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lookout\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lookout\\LookoutServiceProvider"
            ]
        }
    },
    "scripts": {
        "build": "sh bin/build.sh",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
